services:
  - name: wireguard-local
    addr: '127.0.0.1:{{ wg_tcp_port }}'
    handler:
      type: udp
      chain: wireguard-tcp
    listener:
      type: udp
      metadata:
        keepAlive: true
        ttl: 60s
        readBufferSize: 65535
    forwarder:
      nodes:
        - name: wireguard
          addr: '127.0.0.1:{{ wg_socrat_port }}'
chains:
  - name: wireguard-tcp
    hops:
      - name: vps
        nodes:
          - name: socrat-2
            addr: '{{ wg_tcp_server_address }}:{{ wg_tcp_port }}'
            connector:
              type: relay
              auth:
                username: '{{ wg_tcp_username }}'
                password: {{ wg_tcp_auth.content | b64decode | trim | to_json }}
              metadata:
                nodelay: true
            dialer:
              type: tls
              tls:
                secure: true
                serverName: wg-transport.socrat.internal
                caFile: '{{ wg_tcp_directory }}/ca.crt'
