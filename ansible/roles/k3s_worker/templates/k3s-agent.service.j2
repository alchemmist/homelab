[Unit]
Description=Lightweight Kubernetes worker
Wants=network-online.target wg-quick@wg-socrat.service
After=network-online.target wg-quick@wg-socrat.service

[Service]
Type=notify
KillMode=process
Delegate=yes
User=root
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
{% if k3s_worker_manage_kernel_modules | default(true) | bool %}
ExecStartPre=/sbin/modprobe br_netfilter
ExecStartPre=/sbin/modprobe overlay
{% endif %}
ExecStart=/usr/local/bin/k3s agent

[Install]
WantedBy=multi-user.target
