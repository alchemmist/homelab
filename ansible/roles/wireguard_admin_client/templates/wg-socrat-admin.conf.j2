[Interface]
Address = {{ wireguard_admin_address }}
PrivateKey = {{ wireguard_admin_private_key }}

{% for peer in wireguard_admin_peers %}
[Peer]
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.address }}/32
Endpoint = {{ peer.endpoint }}
PersistentKeepalive = {{ wireguard_admin_keepalive }}

{% endfor %}
