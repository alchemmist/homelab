{% if homelab_welcome_enabled %}
case $- in
  *i*)
    if [ -n "${SSH_CONNECTION:-}" ] && [ -t 1 ] && [ "${TERM:-dumb}" != dumb ] && [ "${HOMELAB_WELCOME_CONNECTION:-}" != "$SSH_CONNECTION" ]; then
      export HOMELAB_WELCOME_CONNECTION="$SSH_CONNECTION"
      /usr/bin/python3 /etc/homelab-welcome/welcome.py 2>/dev/null || :
    fi
    ;;
esac
{% endif %}
