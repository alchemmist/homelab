[Unit]
Description=Ignore lid events while Waybar caffeine mode is enabled
PartOf=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/systemd-inhibit --no-ask-password --what=handle-lid-switch --mode=block --who=waybar-caffeine --why="Waybar caffeine mode is enabled" /usr/bin/sleep infinity
Restart=on-failure
RestartSec=1
TimeoutStartSec=10
