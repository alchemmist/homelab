#!/bin/sh
set -eu
/usr/bin/python3 /usr/local/libexec/announce-home-ingress-neighbors --config /etc/home-ingress-neighbors.json
/usr/bin/curl --silent --show-error --fail --noproxy '*' --connect-timeout 1 --max-time 2 \
    --cacert /var/lib/rancher/k3s/server/tls/server-ca.crt \
    --cert /var/lib/rancher/k3s/server/tls/client-admin.crt \
    --key /var/lib/rancher/k3s/server/tls/client-admin.key \
    https://127.0.0.1:6443/readyz >/dev/null
status=$(/usr/bin/curl --silent --show-error --noproxy '*' --connect-timeout 1 --max-time 2 \
    --output /dev/null --write-out '%{http_code}' \
    --header 'Host: ingress-health.invalid' \
    {{ ('http://' ~ home_ingress_ha_nodes[inventory_hostname].address ~ '/') | quote }})
[ "$status" = 404 ]
