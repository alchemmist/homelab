exec /usr/bin/zsh -ic '{{ homelab_monitor_binary }} --config_location {{ homelab_user_home }}/.config/bottom/bottom.toml --default_time_value {{ homelab_monitor_window_seconds }}s --retention {{ homelab_monitor_window_seconds }}s; exec /usr/bin/zsh -i'
