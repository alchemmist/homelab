window {
    background-color: #17212f;
    color: #f1f5fb;
    border: 1px solid #586779;
    border-radius: 12px;
    font-family: "Noto Sans";
    font-size: 15px;
}
#outer-box { padding: 12px; }
#input {
    background-color: #263344;
    color: #ffffff;
    border: 1px solid #586779;
    border-radius: 8px;
    padding: 9px;
    margin-bottom: 10px;
}
#entry { padding: 9px; border-radius: 7px; }
#entry:selected { background-color: #2464ac; }
#text { color: #f1f5fb; }
