# Managed by homelab Ansible. Do not edit manually.
[Interface]
Address = {{ wg_socrat_nodes[inventory_hostname].address }}/24
ListenPort = {{ wg_socrat_port }}
PrivateKey = {{ wg_socrat_private_key }}

{% for peer_name, peer in wg_socrat_nodes.items() if peer_name != inventory_hostname %}
[Peer]
# {{ peer_name }}
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ ([peer.address + "/32"] + wg_socrat_extra_allowed_peer_ips.get(inventory_hostname, {}).get(peer_name, [])) | unique | join(", ") }}
{% set local_peer_endpoints = wg_socrat_peer_endpoints[inventory_hostname] | default(wg_socrat_nodes[inventory_hostname].peer_endpoints | default({})) %}
{% set endpoint = local_peer_endpoints[peer_name] if peer_name in local_peer_endpoints else peer.endpoint | default('') %}
{% if endpoint %}Endpoint = {{ endpoint }}
{% endif %}PersistentKeepalive = {{ wg_socrat_keepalive }}

{% endfor %}
{% for client_name, client in wg_socrat_admin_clients.items() %}
[Peer]
# {{ client_name }}
PublicKey = {{ client.public_key }}
AllowedIPs = {{ client.address }}/32
PersistentKeepalive = {{ wg_socrat_keepalive }}

{% endfor %}
