#!/bin/sh
# Never let K3s silently write runtime data into the root SSD beneath a missing bind.
set -eu
files_source=$(findmnt -nro SOURCE --mountpoint /mnt/files)
[ "${files_source}" = /dev/sdb1 ]
containerd_source=$(findmnt -nro SOURCE --mountpoint /var/lib/rancher/k3s/agent/containerd)
[ "${containerd_source}" = "/dev/sdb1[/homelab/runtime/containerd]" ]
containerd_id=$(stat -c '%d:%i' /var/lib/rancher/k3s/agent/containerd)
runtime_id=$(stat -c '%d:%i' /mnt/files/homelab/runtime/containerd)
[ "${containerd_id}" = "${runtime_id}" ]
cold_backups_source=$(findmnt -nro SOURCE --mountpoint /var/lib/rancher/k3s/storage/pvc-27716289-aa8c-4da0-97b1-3239eae625bf_openhands_openhands-cold-backups)
[ "${cold_backups_source}" = "/dev/sdb1[/homelab/openhands-archives/cold-backups]" ]
upgrade_backups_source=$(findmnt -nro SOURCE --mountpoint /var/lib/rancher/k3s/storage/pvc-59ac8c87-58a0-4bf0-a7cb-a487a9e95728_openhands_openhands-upgrade-backups)
[ "${upgrade_backups_source}" = "/dev/sdb1[/homelab/openhands-archives/upgrade-backups]" ]
