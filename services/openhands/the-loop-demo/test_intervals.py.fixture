import unittest
from intervals import merge_intervals

class IntervalsTest(unittest.TestCase):
    def test_empty(self): self.assertEqual(merge_intervals([]), [])
    def test_single(self): self.assertEqual(merge_intervals([[1, 3]]), [[1, 3]])
    def test_sort(self): self.assertEqual(merge_intervals([[8, 9], [1, 2]]), [[1, 2], [8, 9]])
    def test_overlap(self): self.assertEqual(merge_intervals([[1, 4], [2, 7]]), [[1, 7]])
    def test_touching(self): self.assertEqual(merge_intervals([[1, 4], [4, 7]]), [[1, 7]])
    def test_nested(self): self.assertEqual(merge_intervals([[1, 9], [2, 3], [4, 5]]), [[1, 9]])
    def test_chain(self): self.assertEqual(merge_intervals([[7, 9], [1, 4], [3, 7]]), [[1, 9]])
    def test_no_mutation(self):
        value = [[4, 6], [1, 5]]
        self.assertEqual(merge_intervals(value), [[1, 6]])
        self.assertEqual(value, [[4, 6], [1, 5]])
    def test_invalid(self):
        with self.assertRaises(ValueError): merge_intervals([[5, 2]])
    def test_negative(self): self.assertEqual(merge_intervals([[-5, -1], [-3, 2]]), [[-5, 2]])

if __name__ == '__main__': unittest.main()
