[Unit]
Description=Signed mutation report queue consumer (Monori adapter)
After=network-online.target
[Service]
WorkingDirectory=%h/pi-monori-509-v1
ExecStart=/usr/bin/python3 -Bu %h/pi-monori-509-v1/report_dispatch.py
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=45
UMask=0077
NoNewPrivileges=true
[Install]
WantedBy=default.target
