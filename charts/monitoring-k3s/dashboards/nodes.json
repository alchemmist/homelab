    {
      "id": 16,
      "title": "Дисковый ввод-вывод",
      "description": "Скорость по устройствам, без суммирования физических и логических дисков. Loop, RAM и оптические устройства исключены.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 22,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(rate(node_disk_read_bytes_total{job=\"node-exporter\",device!~\"loop.*|ram.*|sr.*\"}[$__rate_interval])) * on(instance) group_left(nodename) max by (instance, nodename) (node_uname_info{job=\"node-exporter\",nodename=~\"$node\"})",
          "legendFormat": "{{nodename}} · {{device}} · чтение",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "(rate(node_disk_written_bytes_total{job=\"node-exporter\",device!~\"loop.*|ram.*|sr.*\"}[$__rate_interval])) * on(instance) group_left(nodename) max by (instance, nodename) (node_uname_info{job=\"node-exporter\",nodename=~\"$node\"})",
          "legendFormat": "{{nodename}} · {{device}} · запись",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
