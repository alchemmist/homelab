    {
      "id": 19,
      "title": "Outbound traffic",
      "description": "Per interface, including WireGuard. Container and loopback interfaces are excluded.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
