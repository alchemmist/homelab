        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (nodename, device) ((rate(node_network_receive_bytes_total{job=\"node-exporter\",device!~\"lo|veth.*|cali.*|cni.*|flannel.*|docker.*|br-.*\"}[$__rate_interval])) * on(instance) group_left(nodename) max by (instance, nodename) (node_uname_info{job=\"node-exporter\",nodename=~\"$node\"}))",
          "legendFormat": "{{nodename}} · {{device}}",
          "range": true,
