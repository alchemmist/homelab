    {
      "id": 16,
      "title": "Disk I/O",
      "description": "Throughput per device without adding physical and logical disks together. Loop, RAM, and optical devices are excluded.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 22,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (nodename, device) ((rate(node_disk_read_bytes_total{job=\"node-exporter\",device!~\"loop.*|ram.*|sr.*\"}[$__rate_interval])) * on(instance) group_left(nodename) max by (instance, nodename) (node_uname_info{job=\"node-exporter\",nodename=~\"$node\"}))",
          "legendFormat": "{{nodename}} · {{device}} · read",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "avg by (nodename, device) ((rate(node_disk_written_bytes_total{job=\"node-exporter\",device!~\"loop.*|ram.*|sr.*\"}[$__rate_interval])) * on(instance) group_left(nodename) max by (instance, nodename) (node_uname_info{job=\"node-exporter\",nodename=~\"$node\"}))",
          "legendFormat": "{{nodename}} · {{device}} · write",
          "range": true,
          "instant": false
