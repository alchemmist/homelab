      "panels": []
    },
    {
      "id": 24,
      "title": "Container restarts · last hour",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "description": "Up to ten containers with the largest estimated restart count during the hour ending at the selected range end. This is always a one-hour window. Counts may be fractional because Prometheus estimates between samples. An empty table means no detected restarts if source metrics are available.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10,sum by(namespace,pod,container)(increase(kube_pod_container_status_restarts_total[1h])) > 0)",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
