              "pod": true,
              "container": true,
              "Value": true
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "container": 2,
              "Value": 3
            },
            "renameByName": {
              "namespace": "Namespace",
              "pod": "Pod",
              "container": "Container",
              "Value": "Restarts"
            }
          }
        }
      ]
