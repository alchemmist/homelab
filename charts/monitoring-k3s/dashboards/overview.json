    {
      "id": 5,
      "title": "Unready pods",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "description": "Distinct pods with a Pending or Firing KubePodNotReady alert at the end of the selected period. Click the count, then a pod name to open that exact pod in Rancher. This rule excludes Job-owned and scheduling-gated pods. It becomes Firing after 15 minutes. Zero means no matching pod alerts, provided alert evaluation is working.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by(namespace,pod)(ALERTS{alertname=\"KubePodNotReady\",alertstate=~\"pending|firing\"})) or (0 * max(up{job=\"kube-prometheus-stack-prometheus\"} == 1))",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#26783D"
              },
              {
                "value": 1,
                "color": "#A85D08"
              }
            ]
          },
          "links": [
            {
              "title": "View details",
              "url": "/d/socrat-overview/overview?${__url_time_range}&viewPanel=panel-17&var-alert_name=KubePodNotReady&var-alert_state=pending%7Cfiring&var-alert_severity=.*&var-alert_node=.*",
              "targetBlank": false
