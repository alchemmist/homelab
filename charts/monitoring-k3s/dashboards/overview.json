      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "description": "Пустая таблица означает отсутствие сработавших алертов, кроме служебного Watchdog.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by(alertname,severity,namespace)(ALERTS{alertstate=\"firing\",alertname!=\"Watchdog\"})",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "alertname": true,
              "severity": true,
              "namespace": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "namespace": 2
            },
            "renameByName": {
              "alertname": "Алерт",
              "severity": "Уровень",
              "namespace": "Namespace"
            }
          }
        }
      ]
    },
