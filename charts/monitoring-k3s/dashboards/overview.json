    {
      "id": 18,
      "title": "Unready pod alerts",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "description": "Pods with Pending or Firing KubePodNotReady alerts at the end of the selected period. Click a pod name to open its current details in Rancher. An empty table means no matching pod alerts; Job-owned and scheduling-gated pods are excluded by the rule.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(namespace,pod,alertstate)(ALERTS{alertname=\"KubePodNotReady\",alertstate=~\"pending|firing\"})",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pod"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open pod in Rancher",
                    "url": "https://rancher.socrat.alchemmist.xyz/dashboard/c/local/explorer/pod/${__data.fields.Namespace}/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "namespace": true,
              "pod": true,
              "alertstate": true
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "alertstate": 2
            },
            "renameByName": {
              "namespace": "Namespace",
              "pod": "Pod",
              "alertstate": "State"
            }
          }
        }
      ]
    },
    {
      "id": 17,
      "title": "Alert details",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "description": "Alert instances matching the state and severity selected by the Cluster health card, at the end of the selected period. Labels provide rule context; some rules carry the exporter pod rather than the affected workload. Use the Unready pods card for direct links to specific unready pods. Watchdog and InfoInhibitor are excluded. Click an alert name to find its rule and full explanation in Grafana Alerting.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=~\"${alert_state:raw}\",severity=~\"${alert_severity:raw}\",alertname!~\"Watchdog|InfoInhibitor\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Alert"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open alert in Grafana",
