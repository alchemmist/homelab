    {
      "id": 17,
      "title": "Firing alerts",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "description": "Firing alert instances grouped by alert name, severity and namespace at the end of the selected time range. The Watchdog heartbeat is excluded. An empty table means no matching alerts if alert evaluation is working.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by(alertname,severity,namespace)(ALERTS{alertstate=\"firing\",alertname!=\"Watchdog\"})",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "alertname": true,
              "severity": true,
              "namespace": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "namespace": 2
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "namespace": "Namespace"
            }
          }
        }
      ]
    },
    {
      "id": 18,
      "title": "Unready pods",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "description": "Active pods that are not Ready at the end of the selected time range; completed jobs are excluded. An empty table means no matching pods if Kubernetes state metrics are available.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(kube_pod_status_ready{condition=\"true\"} == 0) and on(namespace,pod) (kube_pod_status_phase{phase=~\"Pending|Running|Unknown\"} == 1)",
          "legendFormat": "",
