      "id": 20,
      "title": "etcd · members with a leader",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 8,
        "h": 7
      },
      "description": "Number of scraped etcd members reporting that they have a leader, compared with the number of discovered etcd scrape targets. A gap may indicate a leader or collection problem. The target count is not an independent inventory of all expected members.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(etcd_server_has_leader{job=\"kube-etcd\"})",
          "legendFormat": "With a leader",
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "count(up{job=\"kube-etcd\"})",
          "legendFormat": "Expected",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
