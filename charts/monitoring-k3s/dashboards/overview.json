        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "namespace": true,
              "pod": true
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1
            },
            "renameByName": {
