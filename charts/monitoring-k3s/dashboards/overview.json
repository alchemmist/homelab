      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 22,
      "title": "Pods by phase",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 29,
        "w": 8,
        "h": 7
      },
      "description": "Number of pods in each Kubernetes phase over time. Running does not necessarily mean Ready; Pending means a pod has not yet started running. Completed successful pods are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(phase)(kube_pod_status_phase{phase=~\"Running|Pending|Failed|Unknown\"})",
          "legendFormat": "{{phase}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
