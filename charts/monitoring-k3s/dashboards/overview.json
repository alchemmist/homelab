    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Used and total capacity of ext2/3/4, XFS, Btrfs and ZFS filesystems reported by node-exporter. Each device is counted once per node, even if mounted several times. Used is size minus free, so reserved free blocks are not counted as used. Remote, temporary and overlay filesystems are excluded. Totals describe filesystems, not raw disk capacity or replicated application data. Missing measurements are not replaced with zero. Offline nodes can remain visible until their last series becomes stale.",
      "id": 32,
      "title": "Local filesystems · used and total",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(max by(instance,device)(node_filesystem_size_bytes{job=\"node-exporter\",fstype=~\"ext[234]|xfs|btrfs|zfs\"})) - sum(max by(instance,device)(node_filesystem_free_bytes{job=\"node-exporter\",fstype=~\"ext[234]|xfs|btrfs|zfs\"})))",
          "instant": true,
          "format": "time_series",
          "legendFormat": "Used"
        },
        {
          "refId": "B",
          "expr": "sum(max by(instance,device)(node_filesystem_size_bytes{job=\"node-exporter\",fstype=~\"ext[234]|xfs|btrfs|zfs\"}))",
          "instant": true,
          "format": "time_series",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Node resources",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "title": "CPU utilization",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "description": "Non-idle CPU time as a percentage of all logical CPU capacity on each node, averaged over the automatic rate interval. Includes I/O wait. Near 100% means little idle CPU time remains; it does not distinguish computation from waiting for I/O. Cluster is weighted by logical CPU count or total physical memory rather than giving equally weighted nodes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (nodename) ((100 * (1 - avg by(instance)(rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[$__rate_interval])))) * on(instance) group_left(nodename) max by (instance, nodename) (node_uname_info{job=\"node-exporter\"}))",
          "legendFormat": "{{nodename}}",
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "100 * (sum(1 - avg by(instance,cpu)(rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[$__rate_interval])))) / (count(avg by(instance,cpu)(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"})))",
          "instant": false,
          "format": "time_series",
          "legendFormat": "Cluster"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          },
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "title": "Memory utilization",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "description": "Percentage of RAM not available for new applications on each node: total memory minus the kernel estimate of available memory. Reclaimable cache is accounted for. A rising value means less RAM headroom. Cluster is weighted by logical CPU count or total physical memory rather than giving equally weighted nodes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (nodename) ((100 * (1 - node_memory_MemAvailable_bytes{job=\"node-exporter\"} / node_memory_MemTotal_bytes{job=\"node-exporter\"})) * on(instance) group_left(nodename) max by (instance, nodename) (node_uname_info{job=\"node-exporter\"}))",
          "legendFormat": "{{nodename}}",
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "100 * ((sum(avg by(instance)(node_memory_MemTotal_bytes{job=\"node-exporter\"})) - sum(avg by(instance)(node_memory_MemAvailable_bytes{job=\"node-exporter\"})))) / (sum(avg by(instance)(node_memory_MemTotal_bytes{job=\"node-exporter\"})))",
          "instant": false,
          "format": "time_series",
          "legendFormat": "Cluster"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          },
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "title": "Root filesystem utilization",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "description": "Percentage of the root filesystem unavailable to ordinary processes on each node, including used space and filesystem reservations. Near 100% means little writable space remains; other mount points are not included.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (nodename) ((100 * (1 - node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"node-exporter\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})) * on(instance) group_left(nodename) max by (instance, nodename) (node_uname_info{job=\"node-exporter\"}))",
          "legendFormat": "{{nodename}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          },
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
