{
  "uid": "socrat-overview",
  "title": "Overview",
  "description": "Cluster overview: Kubernetes health, resources, and alerts. External service probes and notification delivery are not configured yet.",
  "tags": [
    "Primary"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 2,
      "type": "row",
      "title": "Cluster health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "title": "Critical alerts",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "description": "Firing critical alert instances at the end of the selected period. Click to see the affected resources. Zero means no matching alert instances, provided alert evaluation is working.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\",severity=\"critical\",alertname!~\"Watchdog|InfoInhibitor\"}) or (0 * max(up{job=\"kube-prometheus-stack-prometheus\"} == 1))",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#26783D"
              },
              {
                "value": 1,
                "color": "#B42332"
              }
            ]
          },
          "links": [
            {
              "title": "View details",
              "url": "/d/socrat-overview/overview?${__url_time_range}&viewPanel=panel-17&var-alert_state=firing&var-alert_severity=critical",
              "targetBlank": false
            }
          ],
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "text": {
          "valueSize": 44
        }
      }
    },
