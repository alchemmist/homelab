            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#26783D"
              },
              {
                "value": 1,
                "color": "#A85D08"
              }
            ]
          },
          "links": [
            {
              "title": "View details",
              "url": "/d/socrat-overview/overview?${__url_time_range}&viewPanel=panel-18",
              "targetBlank": false
            }
          ],
          "noValue": "No telemetry"
        },
        "overrides": []
