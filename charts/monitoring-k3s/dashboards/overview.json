    {
      "id": 8,
      "title": "VPN",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 4
      },
      "description": "Доля доступных реплик от требуемых. Готовность подов не проверяет VPN-туннель или HTTP-доступность снаружи.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * max(kube_deployment_status_replicas_available{namespace=\"x-ui\",deployment=\"x-ui\"}) / clamp_min(max(kube_deployment_spec_replicas{namespace=\"x-ui\",deployment=\"x-ui\"}),1)",
          "legendFormat": "",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Нет данных",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 100,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
