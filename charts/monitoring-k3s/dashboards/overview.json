    {
      "id": 26,
      "title": "Cluster resource capacity",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Non-idle logical CPU cores and total logical cores observed by node-exporter. CPU usage is averaged over the rate interval; capacity is host CPU capacity, not Kubernetes allocatable CPU. Duplicate exporter identities are averaged per node and CPU. Missing measurements are not replaced with zero. Offline nodes can remain visible until their last series becomes stale.",
      "id": 27,
      "title": "CPU utilization",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(1 - avg by(instance,cpu)(rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[$__rate_interval])))) / (count(avg by(instance,cpu)(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"})))",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Host memory in use, calculated as total minus MemAvailable, and total physical memory. Reclaimable cache remains available. This is actual host usage, not pod requests or Kubernetes allocatable memory. Duplicate exporter identities are averaged per node. Missing measurements are not replaced with zero. Offline nodes can remain visible until their last series becomes stale.",
      "id": 28,
      "title": "Memory utilization",
      "type": "gauge",
      "gridPos": {
        "x": 8,
        "y": 11,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum(avg by(instance)(node_memory_MemTotal_bytes{job=\"node-exporter\"})) - sum(avg by(instance)(node_memory_MemAvailable_bytes{job=\"node-exporter\"})))) / (sum(avg by(instance)(node_memory_MemTotal_bytes{job=\"node-exporter\"})))",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Used and total capacity of ext2/3/4, XFS, Btrfs and ZFS filesystems reported by node-exporter. Each device is counted once per node, even if mounted several times. Used is size minus free, so reserved free blocks are not counted as used. Remote, temporary and overlay filesystems are excluded. Totals describe filesystems, not raw disk capacity or replicated application data. Missing measurements are not replaced with zero. Offline nodes can remain visible until their last series becomes stale.",
      "id": 29,
      "title": "Local filesystems utilization",
      "type": "gauge",
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum(max by(instance,device)(node_filesystem_size_bytes{job=\"node-exporter\",fstype=~\"ext[234]|xfs|btrfs|zfs\"})) - sum(max by(instance,device)(node_filesystem_free_bytes{job=\"node-exporter\",fstype=~\"ext[234]|xfs|btrfs|zfs\"})))) / (sum(max by(instance,device)(node_filesystem_size_bytes{job=\"node-exporter\",fstype=~\"ext[234]|xfs|btrfs|zfs\"})))",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Non-idle logical CPU cores and total logical cores observed by node-exporter. CPU usage is averaged over the rate interval; capacity is host CPU capacity, not Kubernetes allocatable CPU. Duplicate exporter identities are averaged per node and CPU. Missing measurements are not replaced with zero. Offline nodes can remain visible until their last series becomes stale.",
      "id": 30,
      "title": "CPU · used and total",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(1 - avg by(instance,cpu)(rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[$__rate_interval])))",
          "instant": true,
          "format": "time_series",
          "legendFormat": "Used"
        },
        {
          "refId": "B",
          "expr": "count(avg by(instance,cpu)(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}))",
          "instant": true,
          "format": "time_series",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Host memory in use, calculated as total minus MemAvailable, and total physical memory. Reclaimable cache remains available. This is actual host usage, not pod requests or Kubernetes allocatable memory. Duplicate exporter identities are averaged per node. Missing measurements are not replaced with zero. Offline nodes can remain visible until their last series becomes stale.",
      "id": 31,
      "title": "Memory · used and total",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(avg by(instance)(node_memory_MemTotal_bytes{job=\"node-exporter\"})) - sum(avg by(instance)(node_memory_MemAvailable_bytes{job=\"node-exporter\"})))",
          "instant": true,
          "format": "time_series",
          "legendFormat": "Used"
        },
        {
          "refId": "B",
          "expr": "sum(avg by(instance)(node_memory_MemTotal_bytes{job=\"node-exporter\"}))",
          "instant": true,
          "format": "time_series",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": {
