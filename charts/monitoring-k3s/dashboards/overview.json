    {
      "id": 17,
      "title": "Alert details",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 8
      },
      "description": "Alert instances matching the Cluster health filters at the end of the selected period. Click an alert name to open its rule. Readiness, recent OOM and frequent-restart alerts identify the affected namespace and pod; click the Pod field to open that exact pod in Rancher. Other alert types omit pod links to avoid pointing to exporter pods. Watchdog and InfoInhibitor are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(ALERTS{node=~\"${alert_node:raw}\",alertstate=~\"${alert_state:raw}\",severity=~\"${alert_severity:raw}\",alertname=~\"${alert_name:raw}\",alertname!~\"Watchdog|InfoInhibitor\",alertname=~\"KubePodNotReady|SocratContainerOOMKilled|SocratContainerRestartsFrequent\"}, \"affected_pod\", \"$1\", \"pod\", \"(.+)\") or ALERTS{node=~\"${alert_node:raw}\",alertstate=~\"${alert_state:raw}\",severity=~\"${alert_severity:raw}\",alertname=~\"${alert_name:raw}\",alertname!~\"Watchdog|InfoInhibitor\",alertname!~\"KubePodNotReady|SocratContainerOOMKilled|SocratContainerRestartsFrequent\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Alert"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open alert in Grafana",
                    "url": "https://grafana.socrat.alchemmist.xyz/alerting/list?search=${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pod"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open pod in Rancher",
                    "url": "https://rancher.socrat.alchemmist.xyz/dashboard/c/local/explorer/pod/${__data.fields.Namespace}/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "alertname": true,
              "severity": true,
              "alertstate": true,
              "namespace": true,
              "node": true,
              "affected_pod": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "alertstate": 2,
              "namespace": 3,
              "node": 5,
              "affected_pod": 4
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "alertstate": "State",
              "namespace": "Namespace",
              "node": "Node",
              "affected_pod": "Pod"
            }
          }
        }
      ]
    },
