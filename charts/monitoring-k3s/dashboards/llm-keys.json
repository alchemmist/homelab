    {
      "id": 5,
      "title": "Web chat log lines per hour (incomplete)",
      "type": "timeseries",
      "description": "\u0421\u0447\u0438\u0442\u0430\u0435\u0442 \u043d\u0435\u043f\u043e\u043b\u043d\u043e. Image 1b1148ec1e2a does not log a successful chat_session create. This rolling hour counts log lines that mention chat_session/create, which are errors and other noise, not chats. Do not use it to decide pace or bans. Do not sum adjacent points.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"deeperseeker\", k8s_namespace_name=\"deeperseeker\"} |~ \"chat_session/create|created chat_session\" [1h]))",
          "legendFormat": "incomplete log lines / rolling hour"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "incomplete log lines / rolling hour"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Usage over the last 30 days",
      "type": "table",
      "description": "Total tokens and requests by key for the last 30 days. This does not follow the time picker. Local models report zero dollar spend, so tokens are the load.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(sum by (api_key_alias) (label_replace(label_replace(increase(litellm_total_tokens_metric_total{job=\"litellm\",api_key_alias!=\"\",api_key_alias!=\"None\",api_key_alias!~\"venice-acceptance-.*\"}[30d]), \"api_key_alias\", \"vladislav\", \"api_key_alias\", \"^pi$\"), \"api_key_alias\", \"alchemmist\", \"api_key_alias\", \"^(antex-agent|pi-agent)$\")))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (api_key_alias) (label_replace(label_replace(increase(litellm_requests_metric_total{job=\"litellm\",api_key_alias!=\"\",api_key_alias!=\"None\",api_key_alias!~\"venice-acceptance-.*\"}[30d]), \"api_key_alias\", \"vladislav\", \"api_key_alias\", \"^pi$\"), \"api_key_alias\", \"alchemmist\", \"api_key_alias\", \"^(antex-agent|pi-agent)$\"))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            },
            "renameByName": {
              "api_key_alias": "Key",
              "Value #A": "Tokens",
              "Value #B": "Requests"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Tokens",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      }
    }
  ]
}
