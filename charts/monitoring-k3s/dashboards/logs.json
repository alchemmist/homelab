{
  "uid": "socrat-unified-logs",
  "title": "Socrat / Unified logs",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "socrat",
    "logs"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "service_name",
          "stream": "{service_name=~\".+\"}"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "k8s_namespace_name",
          "stream": "{service_name=~\".+\"}"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "host_name",
          "stream": "{service_name=~\".+\"}"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "severity",
        "label": "Severity",
        "type": "custom",
        "query": "trace,debug,info,warn,error,fatal,unknown",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "type": "timeseries",
      "title": "Log volume by service",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (count_over_time({service_name=~\"${service:regex}\",k8s_namespace_name=~\"${namespace:regex}\",host_name=~\"${node:regex}\"} | severity=~\"${severity:regex}\" [$__auto]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors / fatal by service",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (count_over_time({service_name=~\"${service:regex}\",k8s_namespace_name=~\"${namespace:regex}\",host_name=~\"${node:regex}\"} | severity=~\"${severity:regex}\" | severity=~\"error|fatal\" [$__auto]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Unified logs (maximum 1000 lines; use Explore for investigation)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"${service:regex}\",k8s_namespace_name=~\"${namespace:regex}\",host_name=~\"${node:regex}\"} | severity=~\"${severity:regex}\"",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "links": [
        {
          "title": "Explore \u2014 same filters and time",
          "url": "/explore?orgId=1&left=%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22expr%22%3A%22%7Bservice_name%3D~%5C%22${service:regex}%5C%22%2Ck8s_namespace_name%3D~%5C%22${namespace:regex}%5C%22%2Chost_name%3D~%5C%22${node:regex}%5C%22%7D%20%7C%20severity%3D~%5C%22${severity:regex}%5C%22%22%2C%22queryType%22%3A%22range%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D",
          "targetBlank": false
        }
      ]
    }
  ],
  "links": [
    {
      "title": "Explore \u2014 same filters and time",
      "url": "/explore?orgId=1&left=%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22expr%22%3A%22%7Bservice_name%3D~%5C%22${service:regex}%5C%22%2Ck8s_namespace_name%3D~%5C%22${namespace:regex}%5C%22%2Chost_name%3D~%5C%22${node:regex}%5C%22%7D%20%7C%20severity%3D~%5C%22${severity:regex}%5C%22%22%2C%22queryType%22%3A%22range%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D",
      "targetBlank": false
    }
  ]
}
