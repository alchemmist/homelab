{
  "uid": "socrat-storage",
  "title": "Socrat storage: filesystems",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "socrat",
    "storage"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Filesystem capacity",
      "type": "timeseries",
      "description": "Per node and filesystem mountpoint, excluding K3s bind aliases. On socrat-5 / is SSD and /mnt/files is HDD. Missing telemetry is unknown; forecasts are estimates, not guarantees.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(node_filesystem_size_bytes{job=\"node-exporter\",fstype=~\"ext[234]|xfs|btrfs|zfs\",mountpoint!~\"/var/lib/kubelet/.*|/var/lib/rancher/k3s/.*|/run/.*\"}) * on(instance) group_left(nodename) max by(instance,nodename) (node_uname_info{job=\"node-exporter\"})",
          "legendFormat": "{{nodename}} {{mountpoint}} {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Available to applications",
      "type": "timeseries",
      "description": "Per node and filesystem mountpoint, excluding K3s bind aliases. On socrat-5 / is SSD and /mnt/files is HDD. Missing telemetry is unknown; forecasts are estimates, not guarantees.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(node_filesystem_avail_bytes{job=\"node-exporter\",fstype=~\"ext[234]|xfs|btrfs|zfs\",mountpoint!~\"/var/lib/kubelet/.*|/var/lib/rancher/k3s/.*|/run/.*\"}) * on(instance) group_left(nodename) max by(instance,nodename) (node_uname_info{job=\"node-exporter\"})",
          "legendFormat": "{{nodename}} {{mountpoint}} {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Space unavailable to applications (%)",
      "type": "timeseries",
      "description": "Per node and filesystem mountpoint, excluding K3s bind aliases. On socrat-5 / is SSD and /mnt/files is HDD. Missing telemetry is unknown; forecasts are estimates, not guarantees.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * (1 - node_filesystem_avail_bytes{job=\"node-exporter\",fstype=~\"ext[234]|xfs|btrfs|zfs\",mountpoint!~\"/var/lib/kubelet/.*|/var/lib/rancher/k3s/.*|/run/.*\"} / node_filesystem_size_bytes{job=\"node-exporter\",fstype=~\"ext[234]|xfs|btrfs|zfs\",mountpoint!~\"/var/lib/kubelet/.*|/var/lib/rancher/k3s/.*|/run/.*\"})) * on(instance) group_left(nodename) max by(instance,nodename) (node_uname_info{job=\"node-exporter\"})",
          "legendFormat": "{{nodename}} {{mountpoint}} {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Inodes available (%)",
      "type": "timeseries",
      "description": "Per node and filesystem mountpoint, excluding K3s bind aliases. On socrat-5 / is SSD and /mnt/files is HDD. Missing telemetry is unknown; forecasts are estimates, not guarantees.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * node_filesystem_files_free{job=\"node-exporter\",fstype=~\"ext[234]|xfs|btrfs|zfs\",mountpoint!~\"/var/lib/kubelet/.*|/var/lib/rancher/k3s/.*|/run/.*\"} / node_filesystem_files{job=\"node-exporter\",fstype=~\"ext[234]|xfs|btrfs|zfs\",mountpoint!~\"/var/lib/kubelet/.*|/var/lib/rancher/k3s/.*|/run/.*\"}) * on(instance) group_left(nodename) max by(instance,nodename) (node_uname_info{job=\"node-exporter\"})",
          "legendFormat": "{{nodename}} {{mountpoint}} {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Available-space change / second",
      "type": "timeseries",
      "description": "Per node and filesystem mountpoint, excluding K3s bind aliases. On socrat-5 / is SSD and /mnt/files is HDD. Missing telemetry is unknown; forecasts are estimates, not guarantees.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(deriv(node_filesystem_avail_bytes{job=\"node-exporter\",fstype=~\"ext[234]|xfs|btrfs|zfs\",mountpoint!~\"/var/lib/kubelet/.*|/var/lib/rancher/k3s/.*|/run/.*\"}[1h])) * on(instance) group_left(nodename) max by(instance,nodename) (node_uname_info{job=\"node-exporter\"})",
          "legendFormat": "{{nodename}} {{mountpoint}} {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Predicted available in 24h",
      "type": "timeseries",
      "description": "Per node and filesystem mountpoint, excluding K3s bind aliases. On socrat-5 / is SSD and /mnt/files is HDD. Missing telemetry is unknown; forecasts are estimates, not guarantees.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(predict_linear(node_filesystem_avail_bytes{job=\"node-exporter\",fstype=~\"ext[234]|xfs|btrfs|zfs\",mountpoint!~\"/var/lib/kubelet/.*|/var/lib/rancher/k3s/.*|/run/.*\"}[6h], 86400)) * on(instance) group_left(nodename) max by(instance,nodename) (node_uname_info{job=\"node-exporter\"})",
          "legendFormat": "{{nodename}} {{mountpoint}} {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    }
  ],
  "links": [],
  "description": "Physical filesystem overview. socrat-5: / is SSD, /mnt/files is HDD. K3s bind-mount aliases are excluded; missing telemetry is unknown."
}
