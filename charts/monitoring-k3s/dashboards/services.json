{
  "uid": "socrat-services",
  "title": "Services",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "tags": [
    "Primary"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Overview",
      "url": "/d/socrat-overview",
      "type": "link",
      "keepTime": true
    },
    {
      "title": "Nodes",
      "url": "/d/socrat-nodes",
      "type": "link",
      "keepTime": true
    },
    {
      "title": "LLM",
      "url": "/d/socrat-llm",
      "type": "link",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",workload!~\"rancher-webhook|system-upgrade-controller|kube-prometheus-stack-kube-state-metrics|kube-prometheus-stack-operator|rancher-monitoring-dashboards-monitoring-proxy\",workload_type=~\"deployment|statefulset\"},workload)",
        "query": {
          "query": "label_values(namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",workload!~\"rancher-webhook|system-upgrade-controller|kube-prometheus-stack-kube-state-metrics|kube-prometheus-stack-operator|rancher-monitoring-dashboards-monitoring-proxy\",workload_type=~\"deployment|statefulset\"},workload)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "title": "Services reporting metrics",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 2
      },
      "description": "Number of selected Deployments and StatefulSets with replica metrics at the end of the selected time range. This counts workloads, including those scaled to zero, rather than network Services or externally reachable applications.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "text": {
          "titleSize": 11,
          "valueSize": 18
        },
        "orientation": "horizontal",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(label_replace(max by(namespace,deployment) (kube_deployment_spec_replicas{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",deployment=~\"${service:regex}\",deployment!~\"rancher-webhook|system-upgrade-controller|kube-prometheus-stack-kube-state-metrics|kube-prometheus-stack-operator|rancher-monitoring-dashboards-monitoring-proxy\"}), \"workload\", \"$1\", \"deployment\", \"(.+)\") or label_replace(max by(namespace,statefulset) (kube_statefulset_replicas{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",statefulset=~\"${service:regex}\"}), \"workload\", \"$1\", \"statefulset\", \"(.+)\"))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "title": "Ready replicas",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 2
      },
      "description": "Total available Deployment replicas and ready StatefulSet replicas for the selected workloads at the end of the selected time range. This is Kubernetes readiness, not an external application health check.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "text": {
          "titleSize": 11,
          "valueSize": 18
        },
        "orientation": "horizontal",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(label_replace(max by(namespace,deployment) (kube_deployment_status_replicas_available{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",deployment=~\"${service:regex}\",deployment!~\"rancher-webhook|system-upgrade-controller|kube-prometheus-stack-kube-state-metrics|kube-prometheus-stack-operator|rancher-monitoring-dashboards-monitoring-proxy\"}), \"workload\", \"$1\", \"deployment\", \"(.+)\") or label_replace(max by(namespace,statefulset) (kube_statefulset_status_replicas_ready{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",statefulset=~\"${service:regex}\"}), \"workload\", \"$1\", \"statefulset\", \"(.+)\"))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "title": "Missing replicas",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 2
      },
      "description": "Total positive shortfall between desired and available or ready replicas for the selected workloads at the end of the selected time range. Zero means no measured shortfall; absent workload metrics cannot establish health.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 1
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "text": {
          "titleSize": 11,
          "valueSize": 18
        },
        "orientation": "horizontal",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(clamp_min((label_replace(max by(namespace,deployment) (kube_deployment_spec_replicas{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",deployment=~\"${service:regex}\",deployment!~\"rancher-webhook|system-upgrade-controller|kube-prometheus-stack-kube-state-metrics|kube-prometheus-stack-operator|rancher-monitoring-dashboards-monitoring-proxy\"}), \"workload\", \"$1\", \"deployment\", \"(.+)\") or label_replace(max by(namespace,statefulset) (kube_statefulset_replicas{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",statefulset=~\"${service:regex}\"}), \"workload\", \"$1\", \"statefulset\", \"(.+)\")) - on(namespace,workload) (label_replace(max by(namespace,deployment) (kube_deployment_status_replicas_available{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",deployment=~\"${service:regex}\",deployment!~\"rancher-webhook|system-upgrade-controller|kube-prometheus-stack-kube-state-metrics|kube-prometheus-stack-operator|rancher-monitoring-dashboards-monitoring-proxy\"}), \"workload\", \"$1\", \"deployment\", \"(.+)\") or label_replace(max by(namespace,statefulset) (kube_statefulset_status_replicas_ready{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",statefulset=~\"${service:regex}\"}), \"workload\", \"$1\", \"statefulset\", \"(.+)\")), 0))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "title": "Restarts in 1 hour",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 2
      },
      "description": "Estimated container restarts across the selected workloads during the hour ending at the selected range end. The window remains one hour even when the dashboard range changes. Zero means no observed counter increase; missing data is not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 1
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "text": {
          "titleSize": 11,
          "valueSize": 18
        },
        "orientation": "horizontal",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum by(namespace,workload) (sum by(namespace,pod) (increase(kube_pod_container_status_restarts_total[1h])) * on(namespace,pod) group_left(workload) max by(namespace,pod,workload) (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",workload=~\"${service:regex}\",workload!~\"rancher-webhook|system-upgrade-controller|kube-prometheus-stack-kube-state-metrics|kube-prometheus-stack-operator|rancher-monitoring-dashboards-monitoring-proxy\",workload_type=~\"deployment|statefulset\"})))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 100,
      "title": "Readiness and restarts",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 6,
      "title": "Replicas: ready / desired",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 9
      },
      "description": "Current available replicas for Deployments and ready replicas for StatefulSets, alongside their desired counts, at the selected range end. A shortfall means the workload has not reached its target. Zero desired replicas means it is configured to be scaled down.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(max by(namespace,deployment) (kube_deployment_status_replicas_available{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",deployment=~\"${service:regex}\",deployment!~\"rancher-webhook|system-upgrade-controller|kube-prometheus-stack-kube-state-metrics|kube-prometheus-stack-operator|rancher-monitoring-dashboards-monitoring-proxy\"}), \"workload\", \"$1\", \"deployment\", \"(.+)\") or label_replace(max by(namespace,statefulset) (kube_statefulset_status_replicas_ready{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",statefulset=~\"${service:regex}\"}), \"workload\", \"$1\", \"statefulset\", \"(.+)\")",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "Ready",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "label_replace(max by(namespace,deployment) (kube_deployment_spec_replicas{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",deployment=~\"${service:regex}\",deployment!~\"rancher-webhook|system-upgrade-controller|kube-prometheus-stack-kube-state-metrics|kube-prometheus-stack-operator|rancher-monitoring-dashboards-monitoring-proxy\"}), \"workload\", \"$1\", \"deployment\", \"(.+)\") or label_replace(max by(namespace,statefulset) (kube_statefulset_replicas{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",statefulset=~\"${service:regex}\"}), \"workload\", \"$1\", \"statefulset\", \"(.+)\")",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "Desired",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "deployment": true,
              "statefulset": true,
              "__name__": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "workload": "Service",
              "Value #A": "Ready",
              "Value #B": "Desired"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Ready replicas by service",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "description": "Available Deployment replicas or ready StatefulSet replicas for each selected workload over time. A decrease may indicate a rollout, scaling or a readiness problem; compare with desired replica counts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(max by(namespace,deployment) (kube_deployment_status_replicas_available{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",deployment=~\"${service:regex}\",deployment!~\"rancher-webhook|system-upgrade-controller|kube-prometheus-stack-kube-state-metrics|kube-prometheus-stack-operator|rancher-monitoring-dashboards-monitoring-proxy\"}), \"workload\", \"$1\", \"deployment\", \"(.+)\") or label_replace(max by(namespace,statefulset) (kube_statefulset_status_replicas_ready{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",statefulset=~\"${service:regex}\"}), \"workload\", \"$1\", \"statefulset\", \"(.+)\")",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{namespace}} / {{workload}}",
          "format": "time_series",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Restarts in the last hour",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "description": "Estimated container restarts by workload during the preceding hour at every plotted point. This rolling window is always one hour. Zero means no observed restarts; an absent series means the required metrics are unavailable.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,workload) (sum by(namespace,pod) (increase(kube_pod_container_status_restarts_total[1h])) * on(namespace,pod) group_left(workload) max by(namespace,pod,workload) (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",workload=~\"${service:regex}\",workload!~\"rancher-webhook|system-upgrade-controller|kube-prometheus-stack-kube-state-metrics|kube-prometheus-stack-operator|rancher-monitoring-dashboards-monitoring-proxy\",workload_type=~\"deployment|statefulset\"}))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{namespace}} / {{workload}}",
          "format": "time_series",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 101,
      "title": "Resource usage",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 9,
      "title": "CPU usage by service",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "description": "CPU usage summed across all containers and replicas of each selected workload, in logical CPU cores and averaged over the automatic rate interval. A value of 1 is one fully used logical core; this is actual usage, not a resource request.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,workload) (sum by(namespace,pod) (rate(container_cpu_usage_seconds_total{container!=\"\",container!=\"POD\",image!=\"\"}[$__rate_interval])) * on(namespace,pod) group_left(workload) max by(namespace,pod,workload) (namespace_workload_pod:kube_pod_owner:relabel{namespace=~\"x-ui|uptime-kuma|llm|cats|lms|remark42|monori|img-proxy|socrat-home|umami|format-quorum|blog|wiki|cattle-system|cattle-monitoring-system\",workload=~\"${service:regex}\",workload!~\"rancher-webhook|system-upgrade-controller|kube-prometheus-stack-kube-state-metrics|kube-prometheus-stack-operator|rancher-monitoring-dashboards-monitoring-proxy\",workload_type=~\"deployment|statefulset\"}))",
          "datasource": {
            "type": "prometheus",
