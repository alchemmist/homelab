{
  "uid": "lms-performance",
  "title": "LMS \u00b7 Performance & distributed traces",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "lms",
    "performance",
    "tempo"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "tempo",
        "type": "datasource",
        "query": "tempo",
        "current": {
          "text": "Tempo",
          "value": "tempo"
        }
      },
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "Loki",
          "value": "loki"
        }
      },
      {
        "name": "trace_id",
        "type": "textbox",
        "label": "Trace ID (paste from search)",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "log_selector",
        "type": "textbox",
        "label": "Loki stream selector (adapt to deployment labels)",
        "current": {
          "text": "{k8s_namespace_name=\"lms\"}",
          "value": "{k8s_namespace_name=\"lms\"}"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to investigate",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Search sampled traces below. Open a trace in Explore, or paste its ID into **Trace ID** to show the waterfall. `browser.page` \u2192 `browser.api` / `browser.material` \u2192 backend HTTP \u2192 `db.connect`, `db.transaction`, `content.read_render`. `browser.resource` measures full network transfer; fetch spans measure time to response headers. Adjust the Loki stream selector to your actual labels. This is a span waterfall, not a CPU profile."
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Recent LMS traces (TraceQL)",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"lms-backend\" }",
          "limit": 50,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 3,
      "type": "traces",
      "title": "Distributed waterfall \u00b7 $trace_id",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 15
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceId",
          "query": "${trace_id}"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Correlated Loki logs (configure stream labels)",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "${log_selector:raw} |= \"${trace_id}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
