{
  "uid": "lms-performance",
  "title": "LMS \u00b7 Performance & distributed traces",
  "schemaVersion": 39,
  "version": 7,
  "tags": [
    "lms",
    "performance",
    "tempo"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "trace_id",
        "type": "query",
        "label": "Trace ID (auto-selected from available traces)",
        "datasource": {
          "type": "tempo",
          "uid": "tempo"
        },
        "query": {
          "type": 1,
          "label": "lms.trace_id",
          "refId": "TempoTraceIds"
        },
        "definition": "Label values: lms.trace_id",
        "refresh": 2,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "allowCustomValue": false,
        "options": [],
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 3,
      "type": "traces",
      "title": "Distributed waterfall \u00b7 $trace_id",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 21
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "${trace_id}"
        }
      ],
      "description": "Main performance waterfall: expand browser.page \u2192 browser.api \u2192 Traefik \u2192 LMS \u2192 database/rendering spans. A health-check trace legitimately has only one span; select a full browser/page trace to inspect page loading."
    },
    {
      "id": 2,
      "type": "table",
      "title": "Recent LMS traces (TraceQL)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"lms-backend\" }",
          "limit": 50,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Correlated Loki logs \u00b7 selected trace (7-day lookup)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{k8s_namespace_name=\"lms\"} |= \"http trace_id=${trace_id}\"",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "description": "Searches the last 7 days, matching Tempo retention, independently of a narrow dashboard range. Tempo tag discovery is block-granular and may offer an older retained trace. Recent application logs below still follow the dashboard range.",
      "timeFrom": "7d"
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Recent LMS application logs \u00b7 all requests",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{k8s_namespace_name=\"lms\"} |= \"http trace_id=\"",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "description": "Independent of trace selection. Ensures current collection can be checked even when an old selected trace has expired."
    }
  ],
  "links": [
    {
      "title": "CPU flame graphs",
      "type": "link",
      "url": "/d/service-cpu-profiling",
      "targetBlank": false
    }
  ]
}
