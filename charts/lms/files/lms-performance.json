{
  "uid": "lms-performance",
  "title": "LMS \u00b7 Performance & distributed traces",
  "schemaVersion": 39,
  "version": 3,
  "tags": [
    "lms",
    "performance",
    "tempo"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "trace_id",
        "type": "query",
        "label": "Trace ID (auto-selected from available traces)",
        "datasource": {
          "type": "tempo",
          "uid": "tempo"
        },
        "query": {
          "type": 1,
          "label": "lms.trace_id",
          "refId": "TempoTraceIds"
        },
        "definition": "Label values: lms.trace_id",
        "refresh": 2,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "allowCustomValue": false,
        "options": [],
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to investigate",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "The dashboard automatically selects a retained LMS trace from the chosen time range. Use **Trace ID** to select another, or click a trace in the search table to open Explore. The waterfall shows browser, Traefik, LMS and database operations. Selected-trace logs use the real LMS namespace; recent application logs below work independently of trace selection. If the selected time range has no retained traces, choose a recent/wider range. Old trace links may expire according to Tempo retention; this is not a collector failure."
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Recent LMS traces (TraceQL)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"lms-backend\" }",
          "limit": 50,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 3,
      "type": "traces",
      "title": "Distributed waterfall \u00b7 $trace_id",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 15
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "${trace_id}"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Correlated Loki logs \u00b7 selected trace",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{k8s_namespace_name=\"lms\"} |= \"http trace_id=\" |~ \"${trace_id:regex}\"",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "description": "Matches the selected retained trace in the dashboard time range. Trace and log retention are independent; use recent application logs below when investigating old or unavailable IDs."
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Recent LMS application logs \u00b7 all requests",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{k8s_namespace_name=\"lms\"} |= \"http trace_id=\"",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "description": "Independent of trace selection. Ensures current collection can be checked even when an old selected trace has expired."
    }
  ]
}
