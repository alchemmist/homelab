{
  "uid": "service-cpu-profiling",
  "title": "Services \u00b7 CPU flame graphs",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "tags": [
    "profiling",
    "cpu",
    "pyroscope"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "LMS request waterfall",
      "type": "link",
      "url": "/d/lms-performance",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "grafana-pyroscope-datasource",
          "uid": "pyroscope"
        },
        "query": {
          "type": "labelValue",
          "labelName": "service_name",
          "refId": "ServiceNames",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allowCustomValue": false,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU flame graph \u00b7 $service",
      "description": "Sampled GIL-held on-CPU Python stacks, not span durations or a chronological timeline. Width is sampled CPU time; click a stack to zoom, inspect Self/Total in the table, and change the time range to compare intervals. C-extension internals, off-CPU waits and other services are not implicitly profiled.",
      "type": "flamegraph",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "pyroscope"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 23
      },
      "targets": [
        {
          "refId": "A",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "labelSelector": "{service_name=\"${service}\"}",
          "groupBy": [],
          "includeExemplars": false,
          "includeHeatmap": false,
          "heatmapType": "individual",
          "maxNodes": 8192,
          "queryType": "profile"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Sampled CPU usage \u00b7 $service",
      "description": "CPU profile samples over time. Use this timeline to select an interval for the flame graph above. This is sampled Python CPU, not total cgroup CPU.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "pyroscope"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "labelSelector": "{service_name=\"${service}\"}",
          "groupBy": [
            "service_name"
          ],
          "includeExemplars": false,
          "includeHeatmap": false,
          "heatmapType": "individual",
          "maxNodes": 8192,
          "queryType": "metrics"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
