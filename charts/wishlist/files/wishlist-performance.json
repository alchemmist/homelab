{
  "uid": "wishlist-performance",
  "title": "Wishlist \u00b7 Performance & traces",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "wishlist",
    "opentelemetry"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Users / gifts / photos (current inventory)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"wishlist_(users|items|item_images)\",job=\"wishlist\"}",
          "legendFormat": "{{operation}} {{route}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "HTTP p95 (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,route)(rate(wishlist_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{operation}} {{route}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Storage / validation / DB p95 (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,operation)(rate(wishlist_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{operation}} {{route}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "HTTP request rate / errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(route,status)(rate(wishlist_http_requests_total[5m]))",
          "legendFormat": "{{operation}} {{route}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Inventory collection success (not zero-fill)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wishlist_inventory_scrape_success{job=\"wishlist\"}",
          "legendFormat": "{{operation}} {{route}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Collector target up / freshness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"wishlist\"}",
          "legendFormat": "{{operation}} {{route}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "table",
      "title": "Recent Wishlist traces (TraceQL)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"wishlist\" }",
          "limit": 50,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Correlated Loki logs \u00b7 selected trace (7-day lookup)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{k8s_namespace_name=\"wishlist\"} |= \"trace_id=${trace_id}\"",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "description": "Searches the last 7 days, matching Tempo retention, independently of a narrow dashboard range. Tempo tag discovery is block-granular and may offer an older retained trace. Recent application logs below still follow the dashboard range.",
      "timeFrom": "7d"
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Recent Wishlist application logs \u00b7 all requests",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{k8s_namespace_name=\"wishlist\"} |= \"trace_id=\"",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "description": "Independent of trace selection. Ensures current collection can be checked even when an old selected trace has expired."
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "trace_id",
        "type": "textbox",
        "label": "Trace ID (optional log filter)",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  }
}
