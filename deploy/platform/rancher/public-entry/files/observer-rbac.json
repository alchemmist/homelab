[
  {
    "apiVersion": "management.cattle.io/v3",
    "kind": "GlobalRole",
    "metadata": {
      "name": "homelab-observer-login",
      "labels": {
        "homelab.alchemmist.xyz/identity-profile": "observer-v1"
      }
    },
    "displayName": "Homelab observer login",
    "description": "Minimal UI login, no infrastructure creation; native observer cache keeps legacy self credentials scoped.",
    "newUserDefault": true,
    "rules": [
      {
        "apiGroups": [
          "management.cattle.io"
        ],
        "resources": [
          "settings",
          "features",
          "rancherusernotifications"
        ],
        "verbs": [
          "get",
          "list",
          "watch"
        ]
      },
      {
        "apiGroups": [
          "management.cattle.io"
        ],
        "resources": [
          "preferences"
        ],
        "verbs": [
          "get",
          "list",
          "watch",
          "create",
          "update",
          "patch",
          "delete"
        ]
      },
      {
        "apiGroups": [
          "ext.cattle.io"
        ],
        "resources": [
          "useractivities"
        ],
        "verbs": [
          "get",
          "update",
          "patch"
        ]
      },
      {
        "apiGroups": [
          "ext.cattle.io"
        ],
        "resources": [
          "selfusers"
        ],
        "verbs": [
          "create"
        ]
      }
    ]
  },
