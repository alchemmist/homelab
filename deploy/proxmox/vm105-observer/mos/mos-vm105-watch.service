[Unit]
Description=Check only the pinned VM105 guest
[Service]
Type=oneshot
ExecStart=/usr/bin/ssh -F /dev/null -o BatchMode=yes -o IdentitiesOnly=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=yes -o HostKeyAlias=172.18.84.112 -o UserKnownHostsFile=%h/.ssh/homelab-vm105/known_hosts-restored-candidate -i %h/.ssh/mos-vm105-watch root@172.18.85.136 check
TimeoutStartSec=50
