  "internalDataPlaneDecisions": [
    {
      "service": "PostgreSQL databases (Authentik/LMS/n8n/Umami/LiteLLM/Socrat bot/Harbor)",
      "decision": "not-exposed",
      "reason": "Internal application data plane; no new SQL MCP, credentials or data access granted. Archived reference/community PostgreSQL adapters are not an appropriate first-party operational connector."
    },
    {
      "service": "Redis/Valkey caches (Argo CD/Harbor)",
      "decision": "not-exposed",
      "upstream": "https://github.com/redis/mcp-redis",
      "reason": "Redis has an official MCP, but these are internal caches, Harbor uses Valkey, and content/search/write access is not needed for service operations. Inspect health via Argo/Grafana."
    },
    {
      "service": "MariaDB (Uptime Kuma)",
      "decision": "not-exposed",
      "upstream": "https://github.com/MariaDB/mcp",
      "reason": "Official database MCP exists, but direct SQL/data-plane access is not needed and would expose monitoring credentials/data; retain app authorization."
    },
    {
      "service": "K3s/etcd/DNS/local-path/NFS/Fleet/CAPI/Turtles/webhooks/probes/workers",
      "decision": "infrastructure-covered",
      "reason": "Inventoried by workload and host unit. No new database/SSH/shell/general Kubernetes MCP or broad cluster-admin credential. Existing required Rancher/Fleet management remains."
    }
  ],
