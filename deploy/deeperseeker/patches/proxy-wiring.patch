+def _env_proxy(*names):
+    for name in names:
+        value = (os.getenv(name) or "").strip()
+        if value:
+            return value
+    return ""
+
+
+def _curl_session():
+    proxy = _env_proxy("DEEPSEEKER_UPSTREAM_PROXY", "ALL_PROXY", "HTTPS_PROXY")
+    if proxy:
+        return AsyncSession(impersonate="chrome152", timeout=600, proxy=proxy)
+    return AsyncSession(impersonate="chrome152", timeout=600)
+
+
+def _chromium_launch_kwargs(headless, launch_args):
+    kwargs = {
+        "headless": headless,
+        "args": list(launch_args),
+        "ignore_default_args": ["--enable-automation"],
+    }
+    proxy = _env_proxy("DEEPSEEKER_BROWSER_PROXY", "ALL_PROXY", "HTTPS_PROXY")
+    if proxy:
+        kwargs["proxy"] = {"server": proxy, "bypass": "localhost,127.0.0.1"}
+    return kwargs
+
