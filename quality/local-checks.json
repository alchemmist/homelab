{
  "python": {
    "title": "Python correctness",
    "run": "uv run python scripts/quality/lint.py python",
    "results": {
      "native": "reports/python.json"
    }
  },
  "ansible": {
    "title": "Playbook safety",
    "run": "uv run python scripts/quality/lint.py ansible",
    "results": {
      "native": "reports/ansible.json"
    }
  },
  "tests-medium": {
    "title": "Integration tests",
    "run": "uv run python scripts/quality/tests.py medium --isolate-network",
    "results": {
      "junit": "reports/tests-medium.xml"
    }
  },
  "tests-cluster": {
    "title": "Cluster lifecycle",
    "run": "uv run python scripts/quality/tests.py cluster",
    "results": {
      "junit": "reports/tests-cluster.xml"
    }
  },
  "dependencies": {
    "title": "Dependency audit",
    "run": "uv run python scripts/quality/lint.py dependencies",
    "results": {
      "native": "reports/dependencies.json"
    }
  }
}
