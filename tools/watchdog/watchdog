#!/usr/bin/env python3
"""Standalone Linux VPN watchdog. Dispatch only the explicitly selected role."""

import argparse
import os
from pathlib import Path
import sys

ROLES = {
    "server": "server.py",
    "relay": "relay.py",
    "witness": "witness.py",
    "coordinator": "coordinator.py",
}


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, usage="watchdog ROLE [ARGS ...]"
    )
    parser.add_argument("role", choices=ROLES)
    role = parser.parse_args(sys.argv[1:2]).role
    program = Path(__file__).resolve().parent / "runtime" / ROLES[role]
    os.execv(sys.executable, [sys.executable, str(program), *sys.argv[2:]])


if __name__ == "__main__":
    main()
