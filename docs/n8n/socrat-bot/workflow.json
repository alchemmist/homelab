{
  "name": "Socrat Alerts",
  "nodes": [
    {
      "parameters": {
        "path": "socrat-alerts",
        "requireAuth": true
      },
      "id": "c0ffee00-0001-4000-8000-000000000001",
      "name": "Alertmanager Webhook",
      "type": "CUSTOM.socratAlertWebhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "webhookId": "socrat-alerts",
      "credentials": {
        "socratAlertIngress": {
          "id": "ALERT_INGRESS_CREDENTIAL_ID",
          "name": "Socrat alert ingress"
        },
        "httpHeaderAuth": {
          "id": "SPI_WORKER_CREDENTIAL_ID",
          "name": "SPI worker internal"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = items[0].json;\nconst payload = raw.body && (Array.isArray(raw.body.alerts) || raw.body.status) ? raw.body : raw;\nconst alerts = Array.isArray(payload.alerts) ? payload.alerts : [];\nif (!alerts.length) return [];\n\nreturn alerts.map(function (alert) {\n  return {\n    json: {\n      ownerChatId: 891074228,\n      alert: {\n        status: alert.status || 'firing',\n        fingerprint: alert.fingerprint || '',\n        labels: alert.labels || {},\n        annotations: alert.annotations || {},\n      },\n    },\n  };\n});\n"
      },
      "id": "c0ffee00-0002-4000-8000-000000000002",
      "name": "One item per alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://socrat-bot.socrat-bot.svc:8080/v1/messages",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.ownerChatId, alert: $json.alert }) }}",
        "options": {
          "timeout": 20000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "c0ffee00-0003-4000-8000-000000000003",
      "name": "Post Telegram Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SOCRAT_BOT_CREDENTIAL_ID",
          "name": "Socrat bot internal"
        }
      }
    }
  ],
  "connections": {
    "Alertmanager Webhook": {
      "main": [
        [
          {
            "node": "One item per alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per alert": {
      "main": [
        [
          {
            "node": "Post Telegram Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Moscow",
