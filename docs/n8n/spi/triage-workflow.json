    {
      "name": "Select Claimed Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const stages = ['match','collect','analyze','publish'];\nreturn items.filter(item => {\n const x=item.json;\n if(x.contract===1 && x.status==='empty' && x.job_id==='') return false;\n if(x.contract!==1 || !['ready','deferred','complete'].includes(x.status) || !/^[a-f0-9]{64}$/.test(x.job_id||'') || !/^[1-9][0-9]{0,31}$/.test(x.execution_id||'') || x.execution_id!==String($execution.id) || x.workflow_revision!=='durable-v1' || !/^[a-f0-9]{64}$/.test(x.fence||'') || !stages.includes(x.stage) || !Number.isFinite(x.deadline) || !Number.isFinite(x.due_at)) throw new Error('INVALID_SPI_WAIT_ENVELOPE');\n if(x.status==='deferred' && !['LLM_ADMISSION_DEFERRED','WORKER_ADMISSION_DEFERRED','GITHUB_READ_TIMEOUT','GITHUB_READ_NETWORK_ERROR','MATCH_PROGRESS_DEFERRED','GRAPH_CAPTURE_DEFERRED','STORAGE_TRANSIENT'].includes(x.code)) throw new Error('INVALID_SPI_WAIT_CODE');\n if(x.status==='deferred' && x.code==='STORAGE_TRANSIENT' && x.stage!=='publish') throw new Error('INVALID_SPI_WAIT_CODE');\n if(x.status==='deferred' && (x.due_at*1000<=Date.now() || x.due_at>=x.deadline)) throw new Error('INVALID_SPI_WAIT_DUE');\n if(x.deadline*1000<=Date.now()) throw new Error('SPI_EXECUTION_DEADLINE');\n if(x.status==='complete' && (x.stage!=='publish' || !['complete','dry_run'].includes(x.outcome))) throw new Error('INVALID_SPI_TERMINAL_OUTCOME');\n return true;\n});"
      },
      "position": [
        640,
        0
      ],
      "id": "e7d658f0-698a-4a49-b66c-2b5c3336b52c"
    },
