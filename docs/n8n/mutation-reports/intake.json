        "jsCode": "const i=$input.first(); const b=i.binary?.data; if(!b)throw Error('missing binary body'); const raw=b.data && b.data!=='filesystem-v2' ? b.data : (await this.helpers.getBinaryDataBuffer(0,'data')).toString('base64');return [{json:{signature:i.json.headers['x-hub-signature-256']||'',raw}}];"
      }
    },
